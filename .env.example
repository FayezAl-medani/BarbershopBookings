APP_NAME=BarbershopBookings
NODE_ENV=Development
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/barbershop_bookings
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

JWT_ACCESS_SECRET=your-access-secret-key
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRE=7d

# CORS: comma-separated allowed origins (defaults to localhost in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002

# SMS Provider: "console" (dev, default) or "twilio" (production)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
